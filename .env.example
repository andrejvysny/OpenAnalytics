# OpenAnalytics — production environment.
# Copy to `.env` and edit. Lines starting with # are comments.

# ===== Required =====

# Domain that Caddy will serve HTTPS for. Must point an A/AAAA record at this host.
# Use `localhost` to disable TLS and serve plain HTTP (dev / behind another proxy).
CADDY_DOMAIN=oa.example.com

# Email address Let's Encrypt uses to notify of certificate expiry. Required for ACME.
CADDY_ACME_EMAIL=admin@example.com

# Public URLs as users will see them. Used for CORS, invite links, and CLI install snippet.
# These should match what Caddy serves.
PUBLIC_WEB_URL=https://oa.example.com
PUBLIC_API_URL=https://oa.example.com

# 32+ char random secret for signing session cookies. Rotating invalidates all logins.
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Postgres credentials (used by the bundled postgres service AND assembled into DATABASE_URL).
POSTGRES_DB=oa
POSTGRES_USER=oa
POSTGRES_PASSWORD=CHANGE_ME

# ===== Optional =====

# Image tag to deploy. `latest` follows master. Pin to a version (e.g. v0.1.0) for stability.
OA_IMAGE_TAG=latest

# Set to 1 if you're managing schema externally (e.g. running migrations from CI).
# OA_SKIP_MIGRATIONS=0

# Set to 1 to skip seeding model_prices (e.g. you populate it yourself).
# OA_SKIP_SEED=0

# ===== SMTP (for workspace invites + password reset) =====
# Leave SMTP_HOST blank to disable email; invite URLs are still returned in the API response.
# Port 465 → implicit TLS (SMTP_SECURE=true auto). Port 587 → STARTTLS (SMTP_SECURE=false).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=OpenAnalytics <noreply@example.com>
