# OpenAnalytics VPS deployment env. Copy to .env at /opt/openanalytics/.env on host.

# ===== Required =====
OA_DOMAIN=openanalytics.andrejvysny.sk
TRAEFIK_CERT_RESOLVER=letsencrypt

# External Postgres (no bundled DB to save VPS storage).
# Examples:
#   postgres://oa:pw@10.0.0.5:5432/oa
#   postgres://user:pw@host.neon.tech/oa?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB

# 32+ char hex. Generated by deploy.sh if absent.
# Manual generation:  openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_32_HEX_BYTES

# ===== SMTP (optional — enables invite & password-reset emails) =====
# When SMTP_HOST is unset, email features are silently disabled.
# Port 465 = implicit TLS (SMTPS). Port 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=OpenAnalytics <noreply@example.com>

# ===== Other optional =====
# OA_SKIP_MIGRATIONS=0
# OA_SKIP_SEED=0
